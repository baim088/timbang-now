<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nutrisi_hari_ini"
            android:textColor="@color/emerald_green"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Card Pagi -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pagi"
                    android:textColor="@color/charcoal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_pagi_shake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/shake"
                    android:contentDescription="Nutrisi pagi shake" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_pagi_teh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/teh"
                    android:contentDescription="Nutrisi pagi teh" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_pagi_aloe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/aloe"
                    android:contentDescription="Nutrisi pagi aloe" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Siang -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/siang"
                    android:textColor="@color/charcoal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_siang_shake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/shake"
                    android:contentDescription="Nutrisi siang shake" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_siang_teh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/teh"
                    android:contentDescription="Nutrisi siang teh" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_siang_aloe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/aloe"
                    android:contentDescription="Nutrisi siang aloe" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Malam -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/malam"
                    android:textColor="@color/charcoal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_malam_shake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/shake"
                    android:contentDescription="Nutrisi malam shake" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_malam_teh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/teh"
                    android:contentDescription="Nutrisi malam teh" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_malam_aloe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/aloe"
                    android:contentDescription="Nutrisi malam aloe" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
