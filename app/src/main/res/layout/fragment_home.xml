<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_home_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/medium_gray"
            android:textSize="14sp"
            android:fontFamily="@font/plus_jakarta_sans" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Sudahkah Anda menimbang hari ini?"
            android:textColor="@color/charcoal"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="@font/plus_jakarta_sans" />

        <!-- Info Berat Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/berat_terakhir"
                    android:textColor="@color/medium_gray"
                    android:textSize="14sp"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:id="@+id/tv_berat_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/belum_ada_data"
                    android:textColor="@color/stitch_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/bmi_label"
                            android:textColor="@color/medium_gray"
                            android:textSize="12sp"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:id="@+id/tv_bmi_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="@color/charcoal"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/target_berat"
                            android:textColor="@color/medium_gray"
                            android:textSize="12sp"
                            android:fontFamily="@font/plus_jakarta_sans" />

                        <TextView
                            android:id="@+id/tv_target_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="-"
                            android:textColor="@color/charcoal"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Analisa Kebugaran Summary Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/analisa_terakhir"
                    android:textColor="@color/charcoal"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <LinearLayout
                    android:id="@+id/layout_analisa_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BMI"
                            android:textColor="@color/medium_gray"
                            android:textSize="11sp"
                            android:fontFamily="@font/plus_jakarta_sans" />
                        <TextView
                            android:id="@+id/tv_analisa_bmi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/stitch_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lemak"
                            android:textColor="@color/medium_gray"
                            android:textSize="11sp"
                            android:fontFamily="@font/plus_jakarta_sans" />
                        <TextView
                            android:id="@+id/tv_analisa_fat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/charcoal"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Otot"
                            android:textColor="@color/medium_gray"
                            android:textSize="11sp"
                            android:fontFamily="@font/plus_jakarta_sans" />
                        <TextView
                            android:id="@+id/tv_analisa_otot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/charcoal"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="V.Fat"
                            android:textColor="@color/medium_gray"
                            android:textSize="11sp"
                            android:fontFamily="@font/plus_jakarta_sans" />
                        <TextView
                            android:id="@+id/tv_analisa_vfat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/charcoal"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/plus_jakarta_sans" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_analisa_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/belum_ada_data"
                    android:textColor="@color/medium_gray"
                    android:textSize="13sp"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_lakukan_analisa"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/lakukan_analisa"
                    app:icon="@drawable/ic_assessment"
                    app:iconTint="@color/stitch_primary"
                    app:cornerRadius="12dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:contentDescription="@string/cd_tombol_lakukan_analisa" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Water Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/air_minum_hari_ini"
                    android:textColor="@color/charcoal"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <TextView
                    android:id="@+id/tv_air_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0 / 2000 ml"
                    android:textColor="@color/medium_gray"
                    android:textSize="14sp"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <ProgressBar
                    android:id="@+id/progress_air"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="12dp"
                    android:layout_marginTop="8dp"
                    android:max="2000"
                    android:progressTint="@color/stitch_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tambah_air"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="@string/tambah_air"
                    app:cornerRadius="12dp"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:backgroundTint="@color/stitch_primary"
                    android:contentDescription="@string/cd_tambah_air" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Chart Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grafik_progress"
                    android:textColor="@color/charcoal"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/plus_jakarta_sans" />

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/line_chart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/cd_grafik_berat" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
